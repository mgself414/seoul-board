---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { findCategory } from "../../data/categories";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = findCategory(post.data.category);
const base = import.meta.env.BASE_URL;

function fmtDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <nav class="mb-6 text-sm">
    <a href={base} class="text-neutral-500 hover:text-ink no-underline">← 모든 글</a>
  </nav>

  <header class="mb-8 border-b border-neutral-200 pb-6">
    {cat && (
      <p class="text-sm font-medium mb-2 flex items-center gap-1.5" style={`color: ${cat.color}`}>
        <span aria-hidden="true">{cat.icon}</span>
        <span>{cat.name}</span>
      </p>
    )}
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 text-neutral-600">{post.data.summary}</p>
    <div class="mt-4 text-sm text-neutral-500 flex flex-wrap gap-x-3 gap-y-1">
      <span>{post.data.location.district}{post.data.location.area ? ` · ${post.data.location.area}` : ""}</span>
      <span>· {fmtDate(post.data.publishDate)} 게시</span>
      {post.data.visitDate && <span>· {fmtDate(post.data.visitDate)} 방문</span>}
      {post.data.rating !== undefined && <span>· ⭐ {post.data.rating}</span>}
      {post.data.priceRange && <span>· {post.data.priceRange}</span>}
    </div>
    {post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5 list-none p-0">
        {post.data.tags.map((t) => (
          <li class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600">#{t}</li>
        ))}
      </ul>
    )}
  </header>

  <article class="space-y-4 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_p]:leading-relaxed [&_p]:text-neutral-800 [&_strong]:font-semibold [&_a]:text-ink [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5">
    <Content />
  </article>

  <footer class="mt-12 border-t border-neutral-200 pt-6 text-sm text-neutral-500 space-y-2">
    <p>📍 {post.data.location.address}</p>
    {post.data.hours && <p>🕐 {post.data.hours}</p>}
    {post.data.contact && <p>📞 {post.data.contact}</p>}
    {post.data.links && (
      <p class="flex flex-wrap gap-3">
        {post.data.links.naverMap && <a href={post.data.links.naverMap} target="_blank" rel="noopener">네이버 지도</a>}
        {post.data.links.kakaoMap && <a href={post.data.links.kakaoMap} target="_blank" rel="noopener">카카오 지도</a>}
        {post.data.links.instagram && <a href={post.data.links.instagram} target="_blank" rel="noopener">인스타그램</a>}
        {post.data.links.website && <a href={post.data.links.website} target="_blank" rel="noopener">웹사이트</a>}
      </p>
    )}
    <p class="pt-4">
      <a href={base} class="text-ink">← 모든 글 보기</a>
    </p>
  </footer>
</BaseLayout>
